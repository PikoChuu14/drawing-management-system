# Drawing Management System environment template
#
# Handover / server setup notes:
# 1. Copy this file to ".env" on the target computer or company server.
# 2. Run "composer install" and "npm install".
# 3. Run "php artisan key:generate" after copying the file so APP_KEY is unique.
# 4. Update APP_URL, database, mail, and APS values below for that server.
# 5. Run "php artisan migrate --force" after the database is configured.
# 6. Run "php artisan storage:link" if uploaded files must be reachable from the browser.
# 7. For production, run "npm run build", then "php artisan optimize".
# 8. Keep the real ".env" private. Do not commit company passwords, API keys, or secrets.

APP_NAME="Drawing Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local demo can use SQLite. On the company server, use mysql or mariadb
# and fill in the real database name, user, and password from the server.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=drawing_management_system
# DB_USERNAME=root
# DB_PASSWORD=

# These default to the database, so migrations must be run before login,
# caching, sessions, and background jobs will work correctly.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# On production, replace with a real company sender address.
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Autodesk Platform Services values are required for drawing preview/translation.
# Ask the company Autodesk admin for the real client ID and client secret.
# APS_BUCKET must be globally unique, lowercase, 3-128 characters, and should
# contain only letters, numbers, dashes, or underscores.
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_BASE_URL=https://developer.api.autodesk.com
APS_BUCKET=drawing-management-system-dev
APS_REGION=US

VITE_APP_NAME="${APP_NAME}"
